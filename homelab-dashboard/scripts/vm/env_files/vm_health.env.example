# Config for vm_health.sh. Copy to env_files/vm_health.env next to vm_health.sh (e.g. ~/env_files/vm_health.env).
# NEVER commit the real vm_health.env.

# Must match the Worker's WORKER_SECRET (sent as the x-worker-secret header).
# Empty = every --api request gets 403.
WORKER_SECRET=

# Pi5's WireGuard tunnel IP, pinged to report tunnel health
PI_TUNNEL_IP=10.0.0.100

# Optional
# STEAL_ALERT_PCT=20                                    # average steal since last poll
# SERVICE_EXCLUDE="snap.oracle-cloud-agent|vm-health-api"
# ARM_GRAB_SUCCESS_LOG="$HOME/auto_arm_grab_success.log"
# CACHE_DIR="$HOME/jellyfin_cache_hit"

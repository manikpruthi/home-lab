# Config for health.sh. Copy to env_files/health.env next to health.sh (e.g. ~/scripts/env_files/health.env).
# NEVER commit the real health.env.

# /dev/disk/by-id names of the three USB disks (ls -l /dev/disk/by-id/).
# The boot disk is read at partition 2, the others at partition 1.
BOOT_ID=usb-VENDOR_MODEL_SERIAL-0:0
WD_ID=usb-VENDOR_MODEL_SERIAL-0:0
TOSHIBA_ID=usb-VENDOR_MODEL_SERIAL-0:0

# IPv6 DNS resolver to test (the local resolver on 127.0.0.1 is always tested)
DNS6_SERVER=fd00::1

# WireGuard (wg1) tunnel IPs of the Oracle VMs, space-separated, in VM1..VMn order
VM_IPS="10.0.0.1 10.0.0.2 10.0.0.3 10.0.0.4"

# Optional
# SERVICE_EXCLUDE="cloudflared-update|pi-health-api"   # grep -E pattern of units to skip
# LOG_DIR="$HOME/logs/health"

# Local dev secrets — copy to `.dev.vars` and fill in. NEVER commit `.dev.vars`.
# Production values go in: Cloudflare Dashboard → Worker → Settings → Variables and Secrets.

# Admin login for /api/refresh and /api/dismiss-alert (plain text; stored encrypted by Cloudflare)
ADMIN_USER=
ADMIN_PASS=

# Session cookie: __Secure-commandcode_prod_.session_token=<token>
# Rotates server-side; can also be refreshed via the dashboard's Manual Refresh modal.
CC_COOKIE=

# API key for the billing-cycle summary (rotates on CLI re-login; find it in ~/.commandcode/auth.json as the "user_..." key)
CC_API_KEY=

# Optional: force the plan key (go, goat, pro, max-10x ...) instead of detecting it
# from the live 5h/weekly caps. Leave unset for auto-detection.
# CC_PLAN=go

# Optional: what you actually pay per month, if it differs from docs price + 7.8% fee.
# PLAN_PAID_USD=1.08
